#!/usr/bin/env bash
chown -R sddm:sddm /var/lib/sddm/.config/

# Build and enable nabu-tablet-mode if not already compiled
if [ -f /usr/local/share/nabu-tablet-mode/nabu-tablet-mode.c ] && [ ! -f /usr/local/libexec/nabu-tablet-mode ]; then
    mkdir -p /usr/local/libexec
    if command -v gcc >/dev/null 2>&1; then
        gcc -O2 -Wall -Wextra /usr/local/share/nabu-tablet-mode/nabu-tablet-mode.c -o /usr/local/libexec/nabu-tablet-mode
        chmod 755 /usr/local/libexec/nabu-tablet-mode
    fi
fi
if [ -f /etc/systemd/system/nabu-tablet-mode.service ] || [ -f /usr/lib/systemd/system/nabu-tablet-mode.service ]; then
    systemctl enable nabu-tablet-mode.service 2>/dev/null || true
fi

# Enable nabu-autobrightness user service globally for graphical sessions
if [ -f /usr/lib/systemd/user/nabu-autobrightness.service ]; then
    systemctl --global enable nabu-autobrightness.service 2>/dev/null || true
fi

