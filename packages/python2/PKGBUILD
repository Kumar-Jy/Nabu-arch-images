# Maintainer: Kumar-Jy

pkgname=python2
_pybasever=2.7
pkgver=2.7.18
pkgrel=1
pkgdesc="A high-level scripting language (legacy Python 2.7)"
arch=('aarch64')
url="https://www.python.org/"
license=('PSF-2.0')
depends=(
  'bzip2' 'expat' 'gdbm' 'libffi' 'ncurses'
  'openssl' 'readline' 'sqlite' 'zlib'
)
makedepends=('pkg-config')
provides=('python2')
conflicts=('python2-bin')
replaces=('python2-bin')
source=("https://www.python.org/ftp/python/${pkgver}/Python-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/Python-${pkgver}"

  export CFLAGS="${CFLAGS} -fno-semantic-interposition -std=gnu89"
  export CXXFLAGS="${CFLAGS}"

  ./configure \
    --prefix=/usr \
    --enable-shared \
    --enable-unicode=ucs4 \
    --enable-ipv6 \
    --with-system-ffi \
    --with-system-expat \
    --with-dbmliborder=gdbm \
    --with-computed-gotos \
    --with-threads \
    --without-ensurepip

  make -j$(nproc)
}

check() {
  cd "${srcdir}/Python-${pkgver}"
  make -j1 test EXTRATESTOPTS="-x test_io test_multiprocessing test_socket test_signal test_subprocess test_ssl" 2>&1 || true
}

package() {
  cd "${srcdir}/Python-${pkgver}"
  make install DESTDIR="${pkgdir}"

  install -vDm 755 Tools/scripts/pdeps.py \
    "${pkgdir}/usr/bin/pdeps2"
  install -vDm 755 Tools/scripts/pindent.py \
    "${pkgdir}/usr/bin/pindent2"
  install -vDm 755 Tools/scripts/ptags.py \
    "${pkgdir}/usr/bin/ptags2"

  ln -sf python2.7 "${pkgdir}/usr/bin/python2"
  ln -sf python2.7-config "${pkgdir}/usr/bin/python2-config"
  ln -sf python2.7 "${pkgdir}/usr/bin/python"

  rm -f "${pkgdir}/usr/bin/smtpd.py"
  rm -rf "${pkgdir}/usr/lib/python${_pybasever}/test"
  rm -rf "${pkgdir}/usr/lib/python${_pybasever}/config/libpython2.7.a"
}
