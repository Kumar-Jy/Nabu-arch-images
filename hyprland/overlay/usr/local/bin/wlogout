#!/usr/bin/env bash
# Wrapper / fallback for wlogout
if [ -x /usr/bin/wlogout ]; then
    exec /usr/bin/wlogout "$@"
fi

# Fallback touch-friendly power menu using rofi or wofi
options="Lock\nSuspend\nLogout\nReboot\nShutdown"
chosen=$(echo -e "$options" | (rofi -dmenu -i -p "Power" 2>/dev/null || wofi --dmenu -p "Power" 2>/dev/null))

case "$chosen" in
    Lock) hyprlock ;;
    Suspend) systemctl suspend ;;
    Logout) hyprctl dispatch exit ;;
    Reboot) systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
