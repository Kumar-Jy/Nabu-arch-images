#!/usr/bin/env python3
"""
nabu-hypr-rotate: Dynamic screen & touch orientation listener for Hyprland on Xiaomi Pad 5 (nabu)
Connects to iio-sensor-proxy over system D-Bus and adjusts Hyprland transforms on the fly.
"""
import sys
import subprocess
try:
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
except ImportError:
    sys.exit(0)

# Native CSOT NT36523 panel is portrait (1600x2560)
# Transform indices:
# 0: Portrait (native)
# 1: Landscape (90 deg clockwise) [Primary]
# 2: Inverted Portrait (180 deg)
# 3: Inverted Landscape (270 deg)
ORIENTATION_MAP = {
    "normal": 1,               # Landscape (Primary)
    "bottom-up": 3,            # Inverted Landscape
    "left-up": 2,              # Upside-down Portrait
    "right-up": 0,             # Normal Portrait
}

current_transform = 1

def set_orientation(transform):
    global current_transform
    if transform == current_transform:
        return
    current_transform = transform
    try:
        subprocess.run([
            "hyprctl", "keyword", "monitor",
            f"DSI-1,1600x2560@120,0x0,1.6,transform,{transform}"
        ], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([
            "hyprctl", "keyword", "input:touchdevice:transform", str(transform)
        ], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def on_properties_changed(interface, changed, invalidated):
    if "AccelerometerOrientation" in changed:
        orient_str = str(changed["AccelerometerOrientation"])
        if orient_str in ORIENTATION_MAP:
            set_orientation(ORIENTATION_MAP[orient_str])

def main():
    DBusGMainLoop(set_as_default=True)
    try:
        bus = dbus.SystemBus()
        proxy = bus.get_object("net.hadess.SensorProxy", "/net/hadess/SensorProxy")
        sensor_iface = dbus.Interface(proxy, "net.hadess.SensorProxy")
        sensor_iface.ClaimAccelerometer()

        bus.add_signal_receiver(
            on_properties_changed,
            dbus_interface="org.freedesktop.DBus.Properties",
            signal_name="PropertiesChanged",
            path="/net/hadess/SensorProxy"
        )

        loop = GLib.MainLoop()
        loop.run()
    except Exception:
        sys.exit(0)

if __name__ == "__main__":
    main()
