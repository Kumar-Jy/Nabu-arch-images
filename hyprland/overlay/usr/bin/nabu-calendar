#!/usr/bin/env python3
# ==============================================================================
# nabu-calendar: Touch-friendly Date, Time, Location & Calendar for Xiaomi Pad 5
# ==============================================================================

import os
import sys
import time
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

def get_timezone_info():
    try:
        out = subprocess.check_output(["timedatectl", "status"], text=True)
        tz = "Unknown"
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("Time zone:"):
                tz = line.replace("Time zone:", "").strip()
                break
        return tz
    except Exception:
        return time.tzname[0]

def get_all_timezones():
    try:
        out = subprocess.check_output(["timedatectl", "list-timezones"], text=True)
        return [tz.strip() for tz in out.strip().splitlines() if tz.strip()]
    except Exception:
        return [
            "UTC", "Asia/Kolkata", "Asia/Dubai", "Asia/Tokyo", "Asia/Singapore",
            "Europe/London", "Europe/Paris", "Europe/Berlin",
            "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles"
        ]

class TimezoneDialog(Gtk.Dialog):
    def __init__(self, parent):
        super().__init__(title="Select Timezone", transient_for=parent, flags=Gtk.DialogFlags.MODAL)
        self.set_default_size(380, 480)
        self.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)

        box = self.get_content_area()
        box.set_spacing(10)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(16)
        box.set_margin_bottom(10)

        # Search entry
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search timezone (e.g. Kolkata, London, New York)...")
        self.search_entry.connect("search-changed", self.on_search_changed)
        box.pack_start(self.search_entry, False, False, 0)

        # Scrolled window
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_shadow_type(Gtk.ShadowType.ETCHED_IN)
        box.pack_start(scrolled, True, True, 0)

        # List store & filter
        self.store = Gtk.ListStore(str)
        for tz in get_all_timezones():
            self.store.append([tz])

        self.filter = self.store.filter_new()
        self.filter.set_visible_func(self.filter_func)

        # Tree view
        self.treeview = Gtk.TreeView(model=self.filter)
        self.treeview.set_headers_visible(False)
        self.treeview.connect("row-activated", self.on_row_activated)

        renderer = Gtk.CellRendererText()
        renderer.set_property("ypad", 6)
        renderer.set_property("xpad", 10)
        column = Gtk.TreeViewColumn("Timezone", renderer, text=0)
        self.treeview.append_column(column)
        scrolled.add(self.treeview)

        # Buttons
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        select_btn = self.add_button("Select", Gtk.ResponseType.OK)
        select_btn.get_style_context().add_class("action-btn")

        self.show_all()

    def filter_func(self, model, iter, data):
        query = self.search_entry.get_text().strip().lower()
        if not query:
            return True
        tz = model[iter][0].lower()
        return query in tz

    def on_search_changed(self, entry):
        self.filter.refilter()

    def on_row_activated(self, treeview, path, column):
        self.response(Gtk.ResponseType.OK)

    def get_selected_timezone(self):
        selection = self.treeview.get_selection()
        model, iter = selection.get_selected()
        if iter:
            return model[iter][0]
        return None

class NabuCalendarWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Date & Time")
        self.set_name("nabu-calendar-window")
        self.set_default_size(440, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

        # Apply CSS Styling
        css = b"""
        #nabu-calendar-window, dialog {
            background-color: #1e1e2e;
            color: #cdd6f4;
            border: 2px solid rgba(137, 180, 250, 0.4);
            border-radius: 18px;
        }
        .header-time {
            font-size: 34px;
            font-weight: bold;
            color: #89b4fa;
        }
        .header-date {
            font-size: 16px;
            color: #a6adc8;
            margin-bottom: 8px;
        }
        .location-card {
            background-color: rgba(17, 17, 27, 0.6);
            border-radius: 12px;
            padding: 10px 16px;
            margin-bottom: 12px;
        }
        .location-text {
            font-size: 14px;
            color: #cdd6f4;
        }
        calendar {
            background-color: rgba(30, 30, 46, 0.9);
            color: #cdd6f4;
            border-radius: 12px;
            font-size: 14px;
            padding: 8px;
        }
        calendar:selected {
            background-color: #89b4fa;
            color: #11111b;
            border-radius: 6px;
        }
        .action-btn {
            background-color: rgba(137, 180, 250, 0.15);
            color: #89b4fa;
            border: 1px solid rgba(137, 180, 250, 0.3);
            border-radius: 10px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 500;
        }
        .action-btn:hover {
            background-color: rgba(137, 180, 250, 0.3);
        }
        .close-btn {
            background-color: rgba(243, 139, 168, 0.15);
            color: #f38ba8;
            border: 1px solid rgba(243, 139, 168, 0.3);
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 13px;
        }
        .close-btn:hover {
            background-color: rgba(243, 139, 168, 0.3);
        }
        treeview {
            background-color: rgba(17, 17, 27, 0.7);
            color: #cdd6f4;
            font-size: 14px;
        }
        treeview:selected {
            background-color: #89b4fa;
            color: #11111b;
        }
        entry {
            background-color: rgba(17, 17, 27, 0.8);
            color: #cdd6f4;
            border-radius: 8px;
            padding: 6px 10px;
            border: 1px solid rgba(137, 180, 250, 0.3);
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        main_box.set_margin_top(20)
        main_box.set_margin_bottom(20)
        main_box.set_margin_start(22)
        main_box.set_margin_end(22)
        self.add(main_box)

        # Digital Clock
        self.time_label = Gtk.Label()
        self.time_label.get_style_context().add_class("header-time")
        main_box.pack_start(self.time_label, False, False, 0)

        # Date Label
        self.date_label = Gtk.Label()
        self.date_label.get_style_context().add_class("header-date")
        main_box.pack_start(self.date_label, False, False, 0)

        # Location / Timezone Card
        loc_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        loc_box.get_style_context().add_class("location-card")
        
        loc_icon = Gtk.Label()
        loc_icon.set_markup("<span font='18'>󰍎</span>")
        loc_box.pack_start(loc_icon, False, False, 0)

        self.loc_label = Gtk.Label()
        self.loc_label.set_xalign(0)
        self.loc_label.get_style_context().add_class("location-text")
        loc_box.pack_start(self.loc_label, True, True, 0)
        self.refresh_timezone_display()

        main_box.pack_start(loc_box, False, False, 0)

        # Interactive Calendar
        self.calendar = Gtk.Calendar()
        main_box.pack_start(self.calendar, True, True, 4)

        # Action Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        
        tz_btn = Gtk.Button(label="󰒓 Change Timezone")
        tz_btn.get_style_context().add_class("action-btn")
        tz_btn.connect("clicked", self.on_change_tz)
        btn_box.pack_start(tz_btn, True, True, 0)

        sync_btn = Gtk.Button(label="󰑐 Sync Time")
        sync_btn.get_style_context().add_class("action-btn")
        sync_btn.connect("clicked", self.on_sync_time)
        btn_box.pack_start(sync_btn, True, True, 0)

        close_btn = Gtk.Button(label="󰅖 Close")
        close_btn.get_style_context().add_class("close-btn")
        close_btn.connect("clicked", lambda b: Gtk.main_quit())
        btn_box.pack_start(close_btn, False, False, 0)

        main_box.pack_start(btn_box, False, False, 4)

        # Update clock
        self.update_clock()
        GLib.timeout_add_seconds(1, self.update_clock)

    def refresh_timezone_display(self):
        tz_str = get_timezone_info()
        self.loc_label.set_markup(f"<b>Timezone / Location:</b>\n{tz_str}")

    def update_clock(self):
        now = time.localtime()
        self.time_label.set_text(time.strftime("%I:%M:%S %p", now))
        self.date_label.set_text(time.strftime("%A, %B %d, %Y", now))
        return True

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()

    def on_sync_time(self, button):
        subprocess.Popen(["pkexec", "timedatectl", "set-ntp", "true"])
        subprocess.Popen(["notify-send", "Date & Time", "Network Time Synchronization (NTP) triggered."])

    def on_change_tz(self, button):
        dialog = TimezoneDialog(self)
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            selected_tz = dialog.get_selected_timezone()
            if selected_tz:
                try:
                    subprocess.run(["pkexec", "timedatectl", "set-timezone", selected_tz], check=True)
                    subprocess.Popen(["notify-send", "Date & Time", f"Timezone set to {selected_tz}"])
                    self.refresh_timezone_display()
                except Exception as e:
                    subprocess.Popen(["notify-send", "-u", "critical", "Date & Time", f"Failed to set timezone: {e}"])
        dialog.destroy()

if __name__ == "__main__":
    win = NabuCalendarWindow()
    win.show_all()
    Gtk.main()
