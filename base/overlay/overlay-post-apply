#!/usr/bin/env bash

kernver=$(ls /usr/lib/modules/ | sort -V | tail -1)
if [ -n "$kernver" ]; then
  cat > /etc/mkinitcpio.d/linux-nabu.preset << PRESET
# mkinitcpio preset file for the 'linux-nabu' package

ALL_kver="$kernver"

PRESETS=('default')

default_uki="/boot/efi/EFI/arch/arch-linux-nabu.efi"
default_cmdline="/etc/cmdline.d/root.conf"
PRESET

  mkdir -p /etc/kernel
  if [ ! -f /etc/kernel/uki.conf ]; then
    printf '[UKI]\nDeviceTree=/boot/dtb-%s\n' "${kernver}" > /etc/kernel/uki.conf
  elif grep -q '^DeviceTree=' /etc/kernel/uki.conf; then
    sed -i "s|^DeviceTree=.*|DeviceTree=/boot/dtb-${kernver}|" /etc/kernel/uki.conf
  elif grep -q '^\\[UKI\\]' /etc/kernel/uki.conf; then
    sed -i "/^\\[UKI\\]/a DeviceTree=/boot/dtb-${kernver}" /etc/kernel/uki.conf
  else
    printf '\n[UKI]\nDeviceTree=/boot/dtb-%s\n' "${kernver}" >> /etc/kernel/uki.conf
  fi
else
  echo "ERROR: no kernel modules found in /usr/lib/modules - is linux-nabu installed?" >&2
  exit 1
fi

if [ -f /etc/mkinitcpio.conf ]; then
  sed -i -e 's/ autodetect//g' -e 's/ microcode//g' /etc/mkinitcpio.conf
  sed -i 's|^FILES=.*|FILES=(/etc/shadow /etc/passwd)|' /etc/mkinitcpio.conf
fi

IGNORE_PKGS="linux-nabu linux-nabu-headers linux-firmware linux-firmware-intel linux-firmware-nvidia linux-firmware-amdgpu linux-firmware-amd linux-firmware-mediatek linux-firmware-broadcom linux-firmware-realtek linux-firmware-radeon linux-firmware-cirrus linux-firmware-ti linux-firmware-other"
sed -i '/^IgnorePkg/d' /etc/pacman.conf
if grep -q '^#IgnorePkg' /etc/pacman.conf; then
    sed -i "/^#IgnorePkg/c\\IgnorePkg = ${IGNORE_PKGS}" /etc/pacman.conf
else
    sed -i "/^\\[options\\]/a\\IgnorePkg = ${IGNORE_PKGS}" /etc/pacman.conf
fi

NOEXTRACT_RULES="usr/lib/firmware/intel/* usr/lib/firmware/nvidia/* usr/lib/firmware/amdgpu/* usr/lib/firmware/mediatek/* usr/lib/firmware/radeon/* usr/lib/firmware/cirrus/* usr/lib/firmware/brcm/* usr/lib/firmware/ti-connectivity/* usr/lib/firmware/i915/*"
sed -i '/^NoExtract/d' /etc/pacman.conf
if grep -q '^#NoExtract' /etc/pacman.conf; then
    sed -i "/^#NoExtract/c\\NoExtract = ${NOEXTRACT_RULES}" /etc/pacman.conf
else
    sed -i "/^\\[options\\]/a\\NoExtract = ${NOEXTRACT_RULES}" /etc/pacman.conf
fi

# Clean up unused firmware blobs to save disk space
rm -rf /usr/lib/firmware/{intel,nvidia,amdgpu,mediatek,radeon,cirrus,brcm,ti-connectivity,i915}

# Build and enable nabu-tablet-mode
if [ -f /usr/local/share/nabu-tablet-mode/nabu-tablet-mode.c ] && [ ! -f /usr/local/libexec/nabu-tablet-mode ]; then
    mkdir -p /usr/local/libexec
    if command -v gcc >/dev/null 2>&1; then
        gcc -O2 -Wall -Wextra /usr/local/share/nabu-tablet-mode/nabu-tablet-mode.c -o /usr/local/libexec/nabu-tablet-mode
        chmod 755 /usr/local/libexec/nabu-tablet-mode
    fi
fi
if [ -f /etc/systemd/system/nabu-tablet-mode.service ] || [ -f /usr/lib/systemd/system/nabu-tablet-mode.service ]; then
    systemctl enable nabu-tablet-mode.service 2>/dev/null || true
fi

